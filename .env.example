# Copy this file to ".env" for local testing. NEVER commit .env or put these values in GitHub.
# On Vercel, add the same names under Settings > Environment Variables instead.

# --- Local only: do NOT set these on Vercel ---
DEBUG=1
DEMO_MODE=1        # fake payments (instant "paid"). Remove this line to test the real Baraka flow.

SECRET_KEY=change-me
CLUB_NAME=Our Club
ALBUM_TITLE=Our New Album
LAUNCH_DATE=this Saturday
ALBUM_COVER=/static/img/cover.jpg
CONTACT_PHONE=
CONTACT_EMAIL=
LOCATION=Nairobi, Kenya

# Payments: Baraka API
BARAKA_API_URL=https://baraka.sdabaraka.org/api/v1
BARAKA_API_TOKEN=
BARAKA_FUND_ID=
BARAKA_ACCOUNT_REF=LAUNCH
BARAKA_DESCRIPTION=Ambassadors
BARAKA_CALLBACK_SECRET=change-me-long-random
# Public https address of your site. On Vercel you can leave it empty; locally set it to your live site address.
BARAKA_CALLBACK_BASE=

# Cloudflare R2 (leave empty locally to play files from the media/ folder)
R2_ACCOUNT_ID=
R2_KEY=
R2_SECRET=
R2_BUCKET=
